extends RefCounted

# Builds the audio settings page using the existing Main scene as its owner.
static func build(owner):
			owner._add_label("🔊 تنظیمات صدا و موسیقی", 24)
			owner._add_label("تمام صداها و موسیقی‌ها اختصاصی و به‌صورت ریاضی درون بازی ساخته می‌شوند؛ فایل صوتی دارای حق‌نشر استفاده نشده است.", 16)
			owner._add_button(("🔇 خاموش‌کردن موسیقی" if owner.audio_manager.is_music_enabled() else "🎵 روشن‌کردن موسیقی"), self, "toggle_music_enabled")
			owner._add_label("بلندی موسیقی", 17)
			owner._add_audio_slider("music")
			owner._add_button(("🔕 خاموش‌کردن افکت‌ها" if owner.audio_manager.is_effects_enabled() else "🔔 روشن‌کردن افکت‌ها"), self, "toggle_effects_enabled")
			owner._add_label("بلندی افکت‌ها", 17)
			owner._add_audio_slider("effects")
			owner._add_label("🌦️ صدای محیط شهر", 21)
			owner._add_label("یک فضای صوتی انتخاب کن. هر زمان خواستی می‌توانی آن را عوض یا خاموش کنی.", 15)
			owner._add_button(("🔇 خاموش‌کردن صدای محیط" if owner.audio_manager.is_environment_enabled() else "🌿 روشن‌کردن صدای محیط"), self, "toggle_environment_enabled")
			owner._add_label("بلندی صدای محیط", 17)
			owner._add_audio_slider("environment")
			var environment_mode = owner.audio_manager.get_environment_mode()
			owner._add_label("انتخاب فضای محیطی", 17)
			owner._add_button(("🏙️ شهر ✓" if environment_mode == "city" else "🏙️ شهر"), self, "set_environment_mode", ["city"])
			owner._add_button(("🌧️ باران ✓" if environment_mode == "rain" else "🌧️ باران"), self, "set_environment_mode", ["rain"])
			owner._add_button(("🌳 طبیعت و پرندگان ✓" if environment_mode == "nature" else "🌳 طبیعت و پرندگان"), self, "set_environment_mode", ["nature"])
			owner._add_button(("🚗 ترافیک ✓" if environment_mode == "traffic" else "🚗 ترافیک"), self, "set_environment_mode", ["traffic"])
			owner._add_label("🎧 آزمایش صداهای اختصاصی", 21)
			owner._add_button("▶️ صدای کلیک", audio_manager, "play_sfx", ["click"])
			owner._add_button("🏗️ صدای ساخت‌وساز", audio_manager, "play_sfx", ["construction"])
			owner._add_button("🎁 صدای دریافت جایزه", audio_manager, "play_sfx", ["reward"])
			owner._add_button("💧 صدای آب", audio_manager, "play_sfx", ["water"])
			owner._add_button("🐦 صدای پرندگان", audio_manager, "play_sfx", ["birds"])
			owner._add_button("🚨 صدای آژیر اضطراری", audio_manager, "play_sfx", ["siren"])
			owner._add_button("⚠️ هشدار کمبود منابع", audio_manager, "play_sfx", ["warning"])
			owner._add_button("🎉 صدای رویداد شهر", audio_manager, "play_sfx", ["event"])
			owner._add_button("⬅️ بازگشت به شهر", self, "return_home_from_menu")
