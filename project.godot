; Project was converted by built-in tool to Godot 4
; Engine configuration file.
; Mini ZekaCity - Godot 4.4.1

config_version=5

[application]
config/name="Mini ZekaCity"
config/quit_on_go_back=false
run/main_scene="res://Main.tscn"
config/icon="res://assets/minizekacity-icon.svg"
boot_splash/image="res://assets/boot-splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true
boot_splash/bg_color=Color(0.035, 0.075, 0.11, 1)

[display]
window/handheld/orientation=6
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/resizable=true
window/stretch/mode="2d"
window/stretch/aspect="expand"

[internationalization]
rendering/text_driver="ICU / HarfBuzz / Graphite"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
